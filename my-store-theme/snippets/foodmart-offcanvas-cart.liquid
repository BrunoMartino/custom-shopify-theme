<div
  class="offcanvas offcanvas-end"
  data-bs-scroll="true"
  tabindex="-1"
  id="offcanvasCart"
  aria-labelledby="offcanvasCartLabel"
>
  <div class="offcanvas-header justify-content-center">
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'general.accessibility.close' | t }}"></button>
  </div>
  <div class="offcanvas-body">
    <div class="order-md-last">
      <h4 class="d-flex justify-content-between align-items-center mb-3" id="offcanvasCartLabel">
        <span class="text-primary">{{ 'sections.header.cart_title' | t }}</span>
        <span class="badge bg-primary rounded-pill">{{ cart.item_count }}</span>
      </h4>
      {% if cart.item_count > 0 %}
        <ul class="list-group mb-3">
          {% for item in cart.items %}
            <li class="list-group-item d-flex justify-content-between lh-sm">
              <div>
                <h6 class="my-0">
                  <a href="{{ item.url }}" class="text-decoration-none text-dark">{{ item.product.title | escape }}</a>
                </h6>
                {% unless item.variant.title == 'Default Title' %}
                  <small class="text-body-secondary">{{ item.variant.title | escape }}</small>
                {% endunless %}
                <small class="text-body-secondary d-block">× {{ item.quantity }}</small>
              </div>
              <span class="text-body-secondary">{{ item.final_line_price | money }}</span>
            </li>
          {% endfor %}
          <li class="list-group-item d-flex justify-content-between">
            <span>{{ 'sections.header.cart_subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </li>
        </ul>
        <a class="w-100 btn btn-primary btn-lg" href="{{ routes.cart_url }}">
          {{ 'sections.header.view_cart' | t }}
        </a>
        <a class="w-100 btn btn-dark btn-lg mt-2" href="/checkout">
          {{ 'sections.header.checkout' | t }}
        </a>
      {% else %}
        <p class="text-body-secondary mb-4">{{ 'sections.header.cart_empty' | t }}</p>
        <a class="w-100 btn btn-primary btn-lg" href="{{ routes.all_products_collection_url }}">
          {{ 'sections.header.continue_shopping' | t }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
