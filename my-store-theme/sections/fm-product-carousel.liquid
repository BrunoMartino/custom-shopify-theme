{% assign collection = collections[section.settings.collection] %}

<section class="py-5 overflow-hidden foodmart-product-carousel" {{ section.shopify_attributes }} data-swiper-root>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        {% render 'foodmart-section-header',
          title: section.settings.title,
          link_text: section.settings.link_text,
          link_url: section.settings.link_url,
          carousel_nav: 'products',
          nav_button_class: 'btn-primary'
        %}
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="products-carousel swiper" aria-label="{{ section.settings.title | escape }}">
          <div class="swiper-wrapper">
            {% if section.settings.use_collection and collection != blank %}
              {% for product in collection.products limit: section.settings.products_limit %}
                {% render 'foodmart-product-item', product: product, slide: true %}
              {% endfor %}
            {% else %}
              {% for block in section.blocks %}
                {% render 'foodmart-product-item', block: block, slide: true %}
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FM Product carousel",
  "tag": "section",
  "class": "section-foodmart-product-carousel",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Best selling products" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View All Categories →" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "checkbox", "id": "use_collection", "label": "Use Shopify collection", "default": false },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Sunstar Fresh Melon Juice" },
        { "type": "text", "id": "price", "label": "Price", "default": "$18.00" },
        { "type": "text", "id": "qty", "label": "Quantity label", "default": "1 Unit" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.5" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "-15%" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "demo_image", "label": "Demo image filename", "default": "thumb-tomatoes.png" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Product carousel",
      "settings": { "title": "Best selling products" },
      "blocks": [
        { "type": "product_card", "settings": { "demo_image": "thumb-tomatoes.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-tomatoketchup.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-bananas.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-bananas.png", "badge": "" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-tomatoes.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-tomatoketchup.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-bananas.png" } },
        { "type": "product_card", "settings": { "demo_image": "thumb-tomatoes.png" } }
      ]
    }
  ]
}
{% endschema %}
