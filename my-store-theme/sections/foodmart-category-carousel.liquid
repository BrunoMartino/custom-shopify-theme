{% assign collection = collections[section.settings.collection] %}

<section class="py-5 overflow-hidden foodmart-category-carousel" {{ section.shopify_attributes }} data-swiper-root>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        {% render 'foodmart-section-header',
          title: section.settings.title,
          link_text: section.settings.link_text,
          link_url: section.settings.link_url,
          carousel_nav: 'category'
        %}
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="category-carousel swiper" aria-label="{{ section.settings.title | escape }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <a href="{{ block.settings.link | default: '#' }}" class="nav-link category-item swiper-slide" {{ block.shopify_attributes }}>
                <div class="category-item__icon">
                  {% if block.settings.image %}
                    <img
                      src="{{ block.settings.image | image_url: width: 120 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="foodmart-img-cover"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% elsif block.settings.demo_image != blank %}
                    {% render 'foodmart-asset-img',
                      filename: block.settings.demo_image,
                      alt: block.settings.title,
                      class: 'category-item__img',
                      width: 120,
                      height: 120
                    %}
                  {% endif %}
                </div>
                <h3 class="category-title">{{ block.settings.title }}</h3>
              </a>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FM Categories",
  "tag": "section",
  "class": "section-foodmart-categories",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Category" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View All Categories →" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fruits & Veges" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "demo_image", "label": "Demo icon filename", "default": "icon-vegetables-broccoli.png" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Fruits & Veges", "demo_image": "icon-vegetables-broccoli.png" } },
        { "type": "category", "settings": { "title": "Breads & Sweets", "demo_image": "icon-bread-baguette.png" } },
        { "type": "category", "settings": { "title": "Soft Drinks", "demo_image": "icon-soft-drinks-bottle.png" } },
        { "type": "category", "settings": { "title": "Wine & Alcohol", "demo_image": "icon-wine-glass-bottle.png" } },
        { "type": "category", "settings": { "title": "Meat & Poultry", "demo_image": "icon-animal-products-drumsticks.png" } },
        { "type": "category", "settings": { "title": "Flour & Baking", "demo_image": "icon-bread-herb-flour.png" } }
      ]
    }
  ]
}
{% endschema %}
